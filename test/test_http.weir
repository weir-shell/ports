#!/usr/bin/env weir
import "../lib/http.weir" as Acme

// HTTP acceptance:
//   1. Parse the LE staging directory from a fixture (offline-safe).
//   2. Prove Http.send + from json work end-to-end against a LIVE endpoint
//      (GitHub, since this container's egress proxy blocks Let's Encrypt).
//   3. Header lookup (case-insensitive) known-answers.
//   4. Live LE directory GET attempted; the block is reported, not fatal.

let dir = Self.scriptPath |> Path.dir

let check name ok =
    if ok then print $"ok   {name}"
    else
        print $"FAIL {name}"
        fail $"assertion failed: {name}"

let isSome o = (o |> Option.map (fun _ -> true) |> Option.defaultValue false)

// ---- 1. Directory parse from fixture ----
let fixture = File.read $"{dir}/fixtures/directory.json"
let d = Acme.parseDirectory fixture
check "newNonce parsed" (d.newNonce == "https://acme-staging-v02.api.letsencrypt.org/acme/new-nonce")
check "newAccount parsed" (d.newAccount == "https://acme-staging-v02.api.letsencrypt.org/acme/new-acct")
check "newOrder parsed" (d.newOrder == "https://acme-staging-v02.api.letsencrypt.org/acme/new-order")
check "meta.termsOfService present" (isSome d.meta)
print $"  directory: newNonce={d.newNonce}"

// ---- 2. header lookup KATs ----
let hs = [("Content-Type", "application/json"); ("Replay-Nonce", "abc123"); ("Retry-After", "5")]
check "header exact" (Acme.header hs "Replay-Nonce" == Some "abc123")
check "header case-insensitive" (Acme.header hs "replay-nonce" == Some "abc123")
check "header missing -> None" (Acme.header hs "Location" == None)

// ---- 3. LIVE Http.send + from json (GitHub, transport proof) ----
type Meta = { verifiable_password_authentication: bool }
let live = Http.send (Http.get "https://api.github.com/meta")
check "live GET status 200" (live.status == 200)
let meta = live.body |> from json Meta
check "live body parsed to typed record" (meta.verifiable_password_authentication == false || meta.verifiable_password_authentication == true)
check "live response has a Date header" (isSome (Acme.header live.headers "date"))
print $"  live github status={live.status}, typed field read OK"

// ---- 4. Attempt LIVE LE directory GET (may be egress-blocked) ----
let leUrl = "https://acme-staging-v02.api.letsencrypt.org/directory"
let leResp = Http.send (Http.get leUrl)
if leResp.status == 200 then
    let ld = Acme.parseDirectory leResp.body
    check "LIVE LE directory parsed" (ld.newNonce |> Str.contains "new-nonce")
    print "  (real Let's Encrypt directory fetched and parsed)"
if leResp.status <> 200 then
    print $"  NOTE: live LE directory returned {leResp.status} (egress proxy blocks Let's Encrypt in this container; fixture used above)"

print "all HTTP tests passed"
