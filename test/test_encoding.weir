#!/usr/bin/env weir
import "../lib/encoding.weir" as Enc

// Known-answer tests for the encoding layer.

let check name got want =
    if got == want then
        print $"ok   {name}"
    else
        print $"FAIL {name}: got {got} want {want}"
        fail $"KAT failed: {name}"

// --- base64url on text ---
// RFC 7515 Appendix C worked example: {"typ":"JWT",...} not needed;
// use a simple deterministic check. "hello" -> base64 "aGVsbG8=" -> url "aGVsbG8"
check "textToB64url hello" (Enc.textToB64url "hello") "aGVsbG8"

// bytes with +/ and padding: 0xFB 0xFF 0xBF -> base64 "+/+/" -> url "-_-_"
// 0xFB=251,0xFF=255,0xBF=191 -> "+/+/". Feed as hex.
check "b64url +/ -> -_" (Enc.hexToB64url "fbffbf") "-_-_"

// padding strip: "f" (0x66) -> base64 "Zg==" -> url "Zg"
check "pad strip" (Enc.hexToB64url "66") "Zg"

// --- base64url round-trip back to bytes (via standard base64) ---
check "b64url roundtrip -> b64" (Enc.b64urlToB64 "aGVsbG8") "aGVsbG8="
check "b64url roundtrip -> b64 2pad" (Enc.b64urlToB64 "Zg") "Zg=="

// --- hex encoding pieces ---
check "byteToHex 255" (Enc.byteToHex 255) "ff"
check "byteToHex 0" (Enc.byteToHex 0) "00"
check "byteToHex 171" (Enc.byteToHex 171) "ab"

// hex -> standard base64 sanity: "68656c6c6f" ("hello") -> "aGVsbG8="
check "hexToB64 hello" (Enc.hexToB64 "68656c6c6f") "aGVsbG8="

// --- RFC 7638 Section 3.1 worked example (RSA JWK thumbprint) ---
// The canonical JWK members for RSA thumbprint are e, kty, n (sorted).
// The RFC's required-members-only, whitespace-free, lex-sorted JSON is:
//   {"e":"AQAB","kty":"RSA","n":"0vx7agoebGcQSuu...(long)...HdrNP5zw"}
// SHA-256 of that UTF-8 string, base64url, MUST equal:
//   NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs
let rfcN =
    "0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QLPML8W4v6ekKf8b8_bWuxb3s8k8i9uMH3-hnkrN1qKrJz6MdBSf3g_bdZ8yUPI-KaHKZ86ERNI-hHTfndrbPHFRxq3xLLGNMFj4o5RZ7RLGaCUvBmg1B7dwbczBTQnvfLPPzPHYwjhwCZqWtVXWA6f_z8H4-Op8JVJT4TQrpV2xRy0LZ9EKPtF3sJHIYFtGaFxfhbA1PY-ImdcYJ9EixJvFqrbz3d9SdKA_pQksTQRFGdyfBRUyXfvAeuxTQ"
let rfcJwk = $"{{\"e\":\"AQAB\",\"kty\":\"RSA\",\"n\":\"{rfcN}\"}}"
let rfcThumb = rfcJwk |> Str.sha256 |> Enc.hexToB64url
check "RFC7638 RSA thumbprint" rfcThumb "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs"

print "all encoding KATs passed"
