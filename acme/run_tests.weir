#!/usr/bin/env weir
// Stage-1 test runner: encoding KATs, JWS/crypto oracle tests, HTTP tests.
// Ensures keys exist first, then runs each suite as a child weir process.

let dir = Self.scriptPath |> Path.dir
let _keys = sh $"{dir}/test/gen_keys.sh" | orFail "key generation failed"

let suites = ["test/test_encoding.weir"; "test/test_jws.weir"; "test/test_http.weir"]
for s in suites do
    print $"===== {s} ====="
    weir $"{dir}/{s}"
print "===== ALL SUITES PASSED ====="
