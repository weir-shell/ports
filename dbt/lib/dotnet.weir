module Dotnet

// The dotnet project selector, ported from fsx/dotnet/project.fsx +
// the generic selector arm. dbt reads project properties via XPath
// (IsPublishable/IsPackable/IsTestProject); weir reads csproj natively
// with `from xml` — a genuine differentiator (the csproj IS the boundary).
//
// STAGE 1 SCOPE: only the `generic` selector is ported (pattern
// "*.*sproj", ignore test projects). The image/nuget selectors and the
// dependency-graph leaf expansion (solution.fsx makeDependencyTree /
// findLeafDependants) are STUB-WITH-TEACH — expandLeafs returns the
// project path unchanged (dbt's Selector.Default), so no .sln parsing.

import "./types.weir" as T

// A <PropertyGroup> may repeat; each carries the properties we probe as
// optional text leaves (present-or-absent). `from xml` maps a field to
// a child element by local name; a default xmlns is stripped.
type PropertyGroup = {
    IsTestProject: Option<string>
    IsPublishable: Option<string>
    IsPackable: Option<string>
}

type Project = {
    [<Elem "PropertyGroup">]
    groups: seq<PropertyGroup>
}

/// True if any PropertyGroup sets `prop` to "true" (project.fsx
/// hasProperty: /Project/PropertyGroup[*]/{prop}[text()='true']).
let hasProperty : (PropertyGroup -> Option<string>) -> string -> bool

let hasProperty pick projPath =
    let proj = File.read projPath |> from xml Project
    proj.groups
    |> Seq.exists (fun g -> (pick g |> Option.defaultValue "") == "true")

/// project.fsx isTest — IsTestProject=true.
let isTest : string -> bool

let isTest projPath =
    hasProperty (fun g -> g.IsTestProject) projPath

/// project.fsx isPublishable — IsPublishable=true.
let isPublishable : string -> bool

let isPublishable projPath =
    hasProperty (fun g -> g.IsPublishable) projPath

/// project.fsx isPackable — IsPackable=true.
let isPackable : string -> bool

let isPackable projPath =
    hasProperty (fun g -> g.IsPackable) projPath

/// The generic dotnet selector (project.fsx DotnetSelectors.generic):
/// id "dotnet", pattern "*.*sproj", required_when always, ignored_when
/// isTest. Leaf expansion is the default identity (Stage-1 stub — no
/// solution dependency traversal).
let generic : Selector

let generic =
    Selector {
        id = "dotnet"
        patterns = ["*.*sproj"]
        excludePatterns = []
        discoveryRoot = None
        isRequired = fun _ -> true
        isIgnored = isTest
        projectId = fun p -> p.projectId
        expandLeafs = fun ctx -> [ctx.projectPath]
    }
