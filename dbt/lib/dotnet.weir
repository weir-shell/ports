module Dotnet

// The dotnet project selector, ported from fsx/dotnet/project.fsx +
// the generic selector arm. dbt reads project properties via XPath
// (IsPublishable/IsPackable/IsTestProject); weir reads csproj natively
// with `from xml` — a genuine differentiator (the csproj IS the boundary).
//
// STAGE 2.5: the dependency-graph leaf expansion (solution.fsx
// makeDependencyTree / findLeafDependants) is now REAL — lib/sln.weir
// parses the `.sln`, builds the reverse ProjectReference graph, and
// expandLeafs walks it. `generic` keeps the identity expansion (dbt's
// generic uses findLeafDependants; the `default` selector below wires it),
// and `default` mirrors test-dbt/plan.fsx's default profile:
// required_when isPublishable + the leaf-dependant expansion.

import "./types.weir" as Types
import "./sln.weir" as Sln

// A <PropertyGroup> may repeat; each carries the properties we probe as
// optional text leaves (present-or-absent). `from xml` maps a field to
// a child element by local name; a default xmlns is stripped.
type PropertyGroup = {
    IsTestProject: Option<string>
    IsPublishable: Option<string>
    IsPackable: Option<string>
}

type Project = {
    [<Elem "PropertyGroup">]
    groups: seq<PropertyGroup>
}

/// True if any PropertyGroup sets `prop` to "true" (project.fsx
/// hasProperty: /Project/PropertyGroup[*]/{prop}[text()='true']).
let hasProperty : (PropertyGroup -> Option<string>) -> string -> bool

let hasProperty pick projPath =
    let proj = File.read projPath |> from xml Project
    proj.groups
    |> Seq.exists (fun g -> (pick g |> Option.defaultValue "") == "true")

/// project.fsx isTest — IsTestProject=true.
let isTest : string -> bool

let isTest projPath =
    hasProperty (fun g -> g.IsTestProject) projPath

/// project.fsx isPublishable — IsPublishable=true.
let isPublishable : string -> bool

let isPublishable projPath =
    hasProperty (fun g -> g.IsPublishable) projPath

/// project.fsx isPackable — IsPackable=true.
let isPackable : string -> bool

let isPackable projPath =
    hasProperty (fun g -> g.IsPackable) projPath

// --- Leaf expansion via the .sln dependency graph (project.fsx expandWith) ---

/// dbt's `expandWith findDependants ctx`: build the dependency tree from the
/// solution in cwd, then expand the changed project to its leaf dependants
/// using the selector's `isRequired` as the leaf test. The port threads the
/// leaf predicate explicitly (weir's LeafContext carries no selector, unlike
/// dbt's), and takes the walk function (`Sln.findLeafDependants` for the
/// generic/image selectors, `Sln.findAllLeafDependants` for nuget) as an
/// argument — the two dbt `expandWith` instantiations.
let expandWith : (Map<string, seq<string>> -> (string -> bool) -> string -> seq<string>) -> (string -> bool) -> LeafContext -> seq<string>

let expandWith walk isLeaf ctx =
    let slnPath = Sln.findInDir "."
    let tree = Sln.makeDependencyTree slnPath
    walk tree isLeaf ctx.projectPath

/// Leaf expansion for the generic/default dotnet selectors (project.fsx
/// `expand_leafs (expandWith Solution.findLeafDependants)`), with the leaf
/// test = isPublishable (test-dbt/plan.fsx's default profile
/// `required_when DotnetProject.isPublishable`).
let expandLeafsPublishable : LeafContext -> seq<string>

let expandLeafsPublishable ctx =
    expandWith Sln.findLeafDependants isPublishable ctx

/// Leaf expansion for the nuget selector (project.fsx `expand_leafs
/// (expandWith Solution.findAllLeafDependants)`), leaf test = isPackable.
let expandLeafsPackable : LeafContext -> seq<string>

let expandLeafsPackable ctx =
    expandWith Sln.findAllLeafDependants isPackable ctx

/// The generic dotnet selector (project.fsx DotnetSelectors.generic):
/// id "dotnet", pattern "*.*sproj", required_when always, ignored_when
/// isTest, expand_leafs (expandWith findLeafDependants). Alone, its leaf
/// test is `always true`, so expansion is effectively identity; the
/// `default`/`image` selectors below narrow the leaf test to isPublishable.
let generic : Selector

let generic =
    Types.Selector {
        id = "dotnet"
        patterns = ["*.*sproj"]
        excludePatterns = []
        discoveryRoot = None
        isRequired = fun _ -> true
        isIgnored = isTest
        projectId = fun p -> p.projectId
        expandLeafs = fun ctx -> [ctx.projectPath]
    }

/// The `default` dotnet selector — test-dbt/plan.fsx's default profile:
/// `required_when DotnetProject.isPublishable; extend generic`. So it is the
/// generic selector (id "dotnet", pattern "*.*sproj", ignored_when isTest)
/// with `isRequired` narrowed to isPublishable and the leaf-dependant
/// expansion wired to that same predicate. This is the selector the
/// snapshot harness's `default` profile drives.
let default : Selector

let default =
    Types.Selector {
        id = "dotnet"
        patterns = ["*.*sproj"]
        excludePatterns = []
        discoveryRoot = None
        isRequired = isPublishable
        isIgnored = isTest
        projectId = fun p -> p.projectId
        expandLeafs = expandLeafsPublishable
    }

/// The `image` dotnet selector (project.fsx `image`): identical to `default`
/// (required_when isPublishable; extend generic). dbt separates them by
/// profile name; the selector shape is the same.
let image : Selector

let image = default

/// The `nuget` dotnet selector (project.fsx `nuget`): required_when
/// isPackable, extend generic, expand_leafs (expandWith findAllLeafDependants).
/// The fixture has zero nuget snapshots, so this is ported for completeness
/// but not snapshot-validated.
let nuget : Selector

let nuget =
    Types.Selector {
        id = "dotnet"
        patterns = ["*.*sproj"]
        excludePatterns = []
        discoveryRoot = None
        isRequired = isPackable
        isIgnored = isTest
        projectId = fun p -> p.projectId
        expandLeafs = expandLeafsPackable
    }
