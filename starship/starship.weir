module Starship

// the prompt (src/print.rs): resolve the root `format` against every
// module, `$all` standing for the PROMPT_ORDER modules the format does not
// name explicitly. Modules run in parallel (starship's par_iter is
// Seq.pmap here).
//
// Use from the REPL's init.weir:
//
//     import "/path/to/ports/starship/starship.weir" as Starship
//     let prompt st = Starship.prompt st
//     #session { prompt = prompt }

import "./lib/config.weir" as C
import "./lib/fmt.weir" as F
import "./lib/ctx.weir" as X
import "./lib/mods/lang_a.weir" as LangA
import "./lib/mods/lang_b.weir" as LangB
import "./lib/mods/vcs.weir" as Vcs
import "./lib/mods/cloud.weir" as Cloud
import "./lib/mods/sys.weir" as Sys

