// probe: within env overlay + within proc. The `!ev(...)` env sigil in the
// proc-command position was retired after v0.0.46 — use an enclosing
// `within env`.
let ev = Env.ofPairs [("RING_PROBE", "42")]

within env ev
    within proc child = sh -c "echo env is $RING_PROBE; sleep 0.3; exit 7"
        poll timeout=5s interval=50ms
            not (Proc.running child)
        let code = Proc.wait child
        print $"exit={code}"
