module Node

// The node selector, ported from fsx/node/project.fsx.
//
// dbt's node selector is the SIMPLEST in the tree: id "node", a single
// pattern "package.json", and no overrides (required_when defaults to
// always, no ignore, identity leaf expansion). So it is a plain glob-
// discovery selector — Path.glob "package.json" per directory, exactly
// the include-only Stage-2 shape. No leaf graph, no excludes.

import "./types.weir" as T

/// The node selector (project.fsx NodeSelectors.image): id "node",
/// pattern "package.json", all defaults. A package.json IS the project.
let image : Selector

let image =
    T.Selector {
        id = "node"
        patterns = ["package.json"]
        excludePatterns = []
        discoveryRoot = None
        isRequired = fun _ -> true
        isIgnored = fun _ -> false
        projectId = fun p -> p.projectId
        expandLeafs = fun ctx -> [ctx.projectPath]
    }
